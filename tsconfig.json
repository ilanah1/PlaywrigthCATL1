{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "fixtures/**/*.ts", "pages/**/*.ts", "testdata/**/*.ts", "tests/**/*.ts", "utils/**/*.ts"]
}
